{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tab Studio",
  "version": "1.3.0",
  "identifier": "jp.tabstudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tab Studio",
        "width": 1440,
        "height": 950,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#111820",
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
