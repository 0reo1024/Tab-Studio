{
  "name": "tab-studio",
  "version": "1.2.0",
  "description": "Offline guitar tablature editor and player for Windows and macOS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "build": "pnpm run typecheck && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node scripts/desktop-check.mjs",
    "pack:win": "pnpm run build && electron-builder --win --x64 --dir",
    "dist:win": "pnpm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "pnpm run build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "pack:mac": "pnpm run build && node scripts/package-mac-bundles.mjs && python scripts/archive-mac-bundles.py",
    "prepare:assets": "node scripts/prepare-assets.mjs"
  },
  "keywords": [],
  "author": "Tab Studio contributors",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@electron/packager": "20.0.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.4",
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^41.5.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  },
  "private": true,
  "build": {
    "appId": "jp.tabstudio.desktop",
    "productName": "Tab Studio",
    "afterPack": "scripts/mac-adhoc-sign.cjs",
    "directories": {
      "output": "release/1.2.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "licenses/**/*"
    ],
    "win": {
      "extraResources": [{"from":"native","to":"native","filter":["fx-host.py","sfz-host.py","soundfonts.json","nam-models.json","editor_window.py","runtime/**/*","!**/__pycache__/**","!**/*.pyc"]}],
      "target": [
        "nsis"
      ],
      "artifactName": "Tab-Studio-${version}-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "extraResources": [{"from":"native","to":"native","filter":["fx-host.py","sfz-host.py","soundfonts.json","nam-models.json","editor_window.py","runtime/**/*","!**/__pycache__/**","!**/*.pyc"]}],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "minimumSystemVersion": "12.0",
      "artifactName": "Tab-Studio-${version}-mac-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Tab Studio ${version}",
      "contents": [
        {
          "x": 130,
          "y": 180,
          "type": "file"
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asarUnpack": [
      "licenses/**"
    ]
  }
}
